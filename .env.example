# Banco de dados
DATABASE_URL=postgresql://user:password@db:5432/chatbotdb

# Autenticação
JWT_SECRET=troque-por-um-segredo-forte
JWT_ALGORITHM=HS256

# E-mail (SMTP)
SMTP_SERVER=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario@exemplo.com
SMTP_PASS=
EMAIL_FROM=usuario@exemplo.com
DEBUG_EMAILS=false

# Metabase
METABASE_SITE_URL=http://localhost:3000
METABASE_SECRET_KEY=

# Groq
GROQ_API_KEY=
# Modelo usado nas chamadas à Groq. Confira os ids disponíveis para a sua chave em:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-20b
# Opcional: modelo só para a classificação da pergunta. Vazio = usa GROQ_MODEL.
GROQ_CLASSIFIER_MODEL=

# Aplicação
ALLOWED_EMAIL_DOMAINS=unesp.br,unisoma.com
FILES_PATH=./files
DOCUMENTS_BASE_DIR=
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
